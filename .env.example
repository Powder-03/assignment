# Groq API Keys (Comma-separated for round-robin rate limit bypassing)
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2

# OpenRouter API Key configuration (For Embeddings)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini AI Studio configuration (Optional primary, e.g. gemini-2.5-flash or gemini-2.0-flash-lite)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

